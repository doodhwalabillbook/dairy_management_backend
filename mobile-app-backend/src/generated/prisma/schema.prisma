// Dairy Management Backend — Prisma Schema
// Redesigned: CustomerMilkConfig versioning (effectiveFrom pattern)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  VENDOR
  ADMIN
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMode {
  CASH
  UPI
  CARD
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) @db.VarChar(36)
  mobile    String   @unique @db.VarChar(15)
  name      String
  pinHash   String
  role      Role     @default(VENDOR)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor?
}

// ─── Company ─────────────────────────────────────────────────────────────────

model Company {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @unique @db.VarChar(255)
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  gstin     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendors Vendor[]
}

// ─── Vendor ──────────────────────────────────────────────────────────────────

model Vendor {
  id           String       @id @default(uuid()) @db.VarChar(36)
  companyId    String       @db.VarChar(36)
  userId       String?      @unique @db.VarChar(36)
  name         String
  phone        String?
  mobileNumber String?      @unique @db.VarChar(15)
  email        String?
  area         String?
  address      String?
  status       VendorStatus @default(ACTIVE)
  isActive     Boolean      @default(true)
  createdBy    String?      @db.VarChar(36)
  updatedBy    String?      @db.VarChar(36)
  joinedAt     DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company                Company                @relation(fields: [companyId], references: [id])
  user                   User?                  @relation(fields: [userId], references: [id])
  customers              Customer[]
  milkDeliveries         MilkDelivery[]
  extraProductDeliveries ExtraProductDelivery[]
  subscriptions          VendorSubscription[]
  subscriptionRequests   SubscriptionRequest[]
  subscriptionHistories  SubscriptionHistory[]
}

// ─── Area ────────────────────────────────────────────────────────────────────

model Area {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique
  description String?
  status      String   @default("ACTIVE")
  createdBy   String?  @db.VarChar(36)
  updatedBy   String?  @db.VarChar(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customers Customer[]
}

// ─── Customer (identity only — no config fields) ─────────────────────────────

model Customer {
  id               String   @id @default(uuid()) @db.VarChar(36)
  vendorId         String   @db.VarChar(36)
  areaId           String   @db.VarChar(36)
  name             String
  phone            String   @db.VarChar(15)
  address          String
  remainingAmount  Decimal  @default(0) @db.Decimal(10, 2)
  advanceAmount    Decimal  @default(0) @db.Decimal(10, 2)
  registrationDate DateTime @db.Date
  isActive         Boolean  @default(true)
  createdBy        String?  @db.VarChar(36)
  updatedBy        String?  @db.VarChar(36)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vendor                 Vendor                 @relation(fields: [vendorId], references: [id])
  area                   Area                   @relation(fields: [areaId], references: [id])
  milkConfigs            CustomerMilkConfig[]
  milkDeliveries         MilkDelivery[]
  payments               Payment[]
  extraProductDeliveries ExtraProductDelivery[]

  @@index([vendorId])
  @@index([areaId])
  @@index([phone, vendorId])
}

// ─── CustomerMilkConfig (versioned config — effectiveFrom pattern) ────────────

model CustomerMilkConfig {
  id              String   @id @default(uuid()) @db.VarChar(36)
  customerId      String   @db.VarChar(36)
  effectiveFrom   DateTime @db.Date
  morningQuantity Decimal  @db.Decimal(10, 2)
  eveningQuantity Decimal  @db.Decimal(10, 2)
  ratePerLiter    Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, effectiveFrom])
  @@index([customerId, effectiveFrom])
}

// ─── MilkDelivery (daily override / exception) ───────────────────────────────

model MilkDelivery {
  id              String   @id @default(uuid()) @db.VarChar(36)
  vendorId        String   @db.VarChar(36)
  customerId      String   @db.VarChar(36)
  date            DateTime @db.Date
  morningQuantity Decimal  @default(0) @db.Decimal(10, 2)
  eveningQuantity Decimal  @default(0) @db.Decimal(10, 2)
  isEdited        Boolean  @default(false)
  createdBy       String?  @db.VarChar(36)
  updatedBy       String?  @db.VarChar(36)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor        Vendor                 @relation(fields: [vendorId], references: [id])
  customer      Customer               @relation(fields: [customerId], references: [id])
  extraProducts ExtraProductDelivery[]

  @@unique([customerId, date])
  @@index([customerId, date])
  @@index([vendorId, date])
}

// ─── ExtraProductDelivery (daily extra product tracking) ─────────────────────

model ExtraProductDelivery {
  id             String   @id @default(uuid()) @db.VarChar(36)
  customerId     String   @db.VarChar(36)
  vendorId       String   @db.VarChar(36)
  milkDeliveryId String?  @db.VarChar(36)
  date           DateTime @db.Date
  productName    String   @db.VarChar(100)
  quantity       Decimal  @db.Decimal(10, 2)
  unit           String   @db.VarChar(20)
  price          Decimal  @db.Decimal(10, 2)
  notes          String?
  createdBy      String?  @db.VarChar(36)
  updatedBy      String?  @db.VarChar(36)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id])
  vendor       Vendor        @relation(fields: [vendorId], references: [id])
  milkDelivery MilkDelivery? @relation(fields: [milkDeliveryId], references: [id])

  @@index([customerId, date])
  @@index([vendorId, date])
}

// ─── Payment ─────────────────────────────────────────────────────────────────

model Payment {
  id               String      @id @default(uuid()) @db.VarChar(36)
  customerId       String      @db.VarChar(36)
  amountPaid       Decimal     @db.Decimal(10, 2)
  extraAmount      Decimal     @default(0) @db.Decimal(10, 2)
  extraDescription String?
  paymentDate      DateTime    @db.Date
  month            Int
  year             Int
  paymentMode      PaymentMode @default(CASH)
  notes            String?
  createdBy        String?     @db.VarChar(36)
  updatedBy        String?     @db.VarChar(36)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, month, year])
}

// ─── Product Catalog (unchanged) ─────────────────────────────────────────────

model ProductCategory {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(255)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  products Product[]
}

model Product {
  id          String   @id @default(uuid()) @db.VarChar(36)
  categoryId  String   @db.VarChar(36)
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category ProductCategory @relation(fields: [categoryId], references: [id])
}

// ─── Subscription Enums ──────────────────────────────────────────────────────

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionPaymentMode {
  CASH
  QR_CODE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Subscription Models ─────────────────────────────────────────────────────

model SubscriptionPlan {
  id            String   @id @default(uuid()) @db.VarChar(36)
  planCode      String   @unique @db.VarChar(50)
  planName      String   @db.VarChar(100)
  description   String?  @db.Text
  price         Decimal  @db.Decimal(10, 2)
  customerLimit Int? // null represents unlimited
  durationDays  Int      @default(30)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions        VendorSubscription[]
  subscriptionRequests SubscriptionRequest[]
  oldHistories         SubscriptionHistory[] @relation("OldPlanRelation")
  newHistories         SubscriptionHistory[] @relation("NewPlanRelation")
}

model VendorSubscription {
  id         String             @id @default(uuid()) @db.VarChar(36)
  vendorId   String             @db.VarChar(36)
  planId     String             @db.VarChar(36)
  status     SubscriptionStatus @default(ACTIVE)
  startDate  DateTime
  expiryDate DateTime
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  vendor Vendor           @relation(fields: [vendorId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([vendorId])
  @@index([planId])
}

model SubscriptionRequest {
  id              String                  @id @default(uuid()) @db.VarChar(36)
  vendorId        String                  @db.VarChar(36)
  planId          String                  @db.VarChar(36)
  requestedAmount Decimal                 @db.Decimal(10, 2)
  paymentMode     SubscriptionPaymentMode
  requestStatus   RequestStatus           @default(PENDING)
  remarks         String?                 @db.Text
  requestedAt     DateTime                @default(now())
  approvedAt      DateTime?
  approvedBy      String?                 @db.VarChar(36)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  vendor Vendor           @relation(fields: [vendorId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([vendorId])
  @@index([planId])
}

model SubscriptionHistory {
  id          String   @id @default(uuid()) @db.VarChar(36)
  vendorId    String   @db.VarChar(36)
  oldPlanId   String?  @db.VarChar(36)
  newPlanId   String   @db.VarChar(36)
  action      String   @db.VarChar(50) // "INIT", "UPGRADE", "RENEW"
  performedBy String   @db.VarChar(36)
  createdAt   DateTime @default(now())

  vendor  Vendor            @relation(fields: [vendorId], references: [id])
  oldPlan SubscriptionPlan? @relation("OldPlanRelation", fields: [oldPlanId], references: [id])
  newPlan SubscriptionPlan  @relation("NewPlanRelation", fields: [newPlanId], references: [id])

  @@index([vendorId])
  @@index([oldPlanId])
  @@index([newPlanId])
}

model SystemSetting {
  id           String   @id @default(uuid()) @db.VarChar(36)
  settingKey   String   @unique @db.VarChar(100)
  settingValue String   @db.VarChar(255)
  description  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
